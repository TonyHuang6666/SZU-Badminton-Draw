<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadmintonDraw.Desktop.ViewModels" xmlns:views="using:BadmintonDraw.Desktop.Views"
             x:Class="BadmintonDraw.Desktop.Views.ResultImportPanel" x:DataType="vm:WorkspaceResultImportViewModel">
  <Grid RowDefinitions="*,Auto" Margin="0,14,0,0">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20" Margin="0,0,4,20">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="section-title" Text="把填写好的记录表带回比赛" />
            <TextBlock Classes="muted" Text="在导出的 Excel 记录表中填写比赛结果，再选择一份或多份 .xlsx 文件。先检查内容，确认后才保存。" />
            <WrapPanel>
              <Button x:Name="PickResultFiles" Classes="secondary" Content="选择比赛记录表" Command="{Binding PickFilesCommand}" Margin="0,0,10,8" />
              <Button x:Name="PreviewResultImport" Classes="secondary" Content="检查记录表" Command="{Binding PreviewCommand}" Margin="0,0,10,8" />
              <Button x:Name="ClearResultFiles" Classes="quiet" Content="清空选择" Command="{Binding ClearFilesCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="已选文件" FontWeight="SemiBold" />
            <views:ResultImportEvidenceText x:Name="SelectedResultPaths" Text="{Binding SelectedFilesText}" />
          </StackPanel>
        </Border>
        <Border Classes="callout">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="检查结果" />
            <ProgressBar IsVisible="{Binding IsWorking}" IsIndeterminate="True" Height="3" />
            <views:ResultImportEvidenceText x:Name="ResultImportState" Text="{Binding StateMessage}" />
            <views:ResultImportEvidenceText Text="{Binding CountsText}" />
            <views:ResultImportEvidenceText x:Name="ResultImportDiagnostics" Text="{Binding DiagnosticDetails}" />
            <CheckBox x:Name="ConfirmResultImport" IsChecked="{Binding Confirmed}" IsVisible="{Binding HasCurrentPreview}" IsEnabled="{Binding HasCurrentPreview}"><TextBlock Text="我已核对比赛、文件来源、检查结果与更正内容，确认本次操作。" TextWrapping="Wrap" /></CheckBox>
          </StackPanel>
        </Border>
        <Expander Header="核对文件来源与分类">
          <Border Classes="card" Margin="0,10,0,0"><StackPanel Spacing="14">
            <TextBlock Classes="muted" Text="这里保留每份文件的完整路径、文件身份与来源，便于核对重复文件或有疑问的记录。" />
            <views:ResultImportEvidenceText Text="{Binding SourceDetails}" />
            <views:ResultImportEvidenceText Text="{Binding FileDetails}" />
          </StackPanel></Border>
        </Expander>
        <Border Classes="card" IsVisible="{Binding HasCorrections}">
          <StackPanel Spacing="14">
            <TextBlock Classes="section-title" Text="核对已有结果的更正" />
            <TextBlock Classes="muted" Text="请逐项比较更正前后的内容。胜负方冲突无法通过允许更正来接受。" />
            <views:ResultImportEvidenceText x:Name="ResultImportCorrections" Text="{Binding CorrectionDetails}" />
            <CheckBox x:Name="AllowResultCorrections" IsChecked="{Binding AllowCorrections}"><TextBlock Text="我已核对并允许上方列出的比分、时长等信息更正。" TextWrapping="Wrap" /></CheckBox>
            <TextBlock Text="更正原因（更正时必填）" FontWeight="SemiBold" />
            <TextBox x:Name="ResultCorrectionReason" Text="{Binding CorrectionReason}" PlaceholderText="说明核对了哪些来源，以及为什么需要更正"
                     AutomationProperties.Name="赛果更正原因" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
          </StackPanel>
        </Border>
        <Border Classes="inset" IsVisible="{Binding HasOutcome}">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="本次操作的实际结果" />
            <views:ResultImportEvidenceText x:Name="ResultImportOutcome" Text="{Binding OutcomeDetails}" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" Text="仍未填写的记录会保留为待填。完成情况以赛事中已保存的结果为准；作废的旧文件不会再次生效。" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="action-bar" Padding="24,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" Text="请先检查记录表" IsVisible="{Binding !HasCurrentPreview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="请核对检查结果" IsVisible="{Binding HasCurrentPreview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button x:Name="ApplyResultImport" Grid.Column="1" Classes="primary" Content="{Binding ConfirmButtonText}" Command="{Binding ConfirmImportCommand}" Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
