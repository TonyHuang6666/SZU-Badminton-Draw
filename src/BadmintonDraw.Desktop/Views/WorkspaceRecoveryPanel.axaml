<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadmintonDraw.Desktop.ViewModels" x:Class="BadmintonDraw.Desktop.Views.WorkspaceRecoveryPanel" x:DataType="vm:WorkspaceRecoveryViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28,24">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
      <StackPanel Spacing="7">
        <TextBlock Classes="eyebrow" Text="KEEP YOUR PROGRESS SAFE" />
        <TextBlock Classes="page-title" Text="备份与恢复" />
        <TextBlock Classes="page-subtitle" Text="留存当前进度，或检查以前的备份并恢复比赛。" />
      </StackPanel>
      <Button x:Name="CloseRecoveryButton" Grid.Column="1" Classes="quiet" Content="关闭" Command="{Binding CloseCommand}" VerticalAlignment="Top" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20" Margin="0,0,4,20">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="section-title" Text="先为当前进度留一份备份" />
            <TextBlock Classes="muted" Text="任何阶段都可以备份，包括尚未完成的名单和只做公开抽签的比赛。" />
            <SelectableTextBlock Text="{Binding CurrentWorkspaceDetails}" TextWrapping="Wrap" />
            <Button x:Name="CreateBackupButton" Classes="secondary" Content="创建当前比赛的备份" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="eyebrow" Text="01 / CHOOSE A BACKUP" />
            <TextBlock Classes="section-title" Text="选择要恢复的比赛与备份" />
            <Border Classes="inset">
              <StackPanel Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="通常恢复当前打开的比赛" />
                <TextBlock IsVisible="{Binding !RecoverCorruptTarget}" Text="目标是上方当前比赛。请选择属于同一赛事的备份，检查后再决定是否替换。" TextWrapping="Wrap" />
                <CheckBox x:Name="CorruptTargetMode" IsChecked="{Binding RecoverCorruptTarget}">
                  <TextBlock Text="赛事文件已经损坏、无法打开：选择损坏文件进行恢复" TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding RecoverCorruptTarget}" Spacing="10">
              <TextBlock Text="要恢复的损坏文件" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="损坏内容无法验证原赛事身份。请亲自核对目标文件与备份属于同一场比赛，目标也可以不是当前打开的赛事。" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="RecoveryTargetPath" Text="{Binding TargetPath}" PlaceholderText="损坏的 .szbd 赛事文件完整路径" AutomationProperties.Name="损坏目标路径" />
                <Button Grid.Column="1" Classes="secondary" Content="选择损坏文件" Command="{Binding PickTargetCommand}" Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
            <TextBlock Text="用哪一份备份恢复？" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="RecoveryBackupPath" Text="{Binding BackupPath}" PlaceholderText="选择 .szbd 备份文件" AutomationProperties.Name="选定备份路径" />
              <Button Grid.Column="1" Classes="secondary" Content="选择备份" Command="{Binding PickBackupCommand}" Margin="10,0,0,0" />
            </Grid>
            <Button x:Name="PreviewRecoveryButton" Classes="secondary" Content="检查备份与恢复范围" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="muted" Text="这一步只检查文件，不会替换或保存赛事。" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="eyebrow" Text="02 / REVIEW BEFORE RESTORING" />
            <TextBlock Classes="section-title" Text="核对恢复前后的内容" />
            <Border Classes="inset"><SelectableTextBlock x:Name="RecoveryPreviewDetails" Text="{Binding PreviewDetails}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="恢复原因（必填，会保留在操作记录中）" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBox x:Name="RecoveryReason" Text="{Binding Reason}" PlaceholderText="说明为什么恢复，以及如何确认这份备份正确" AutomationProperties.Name="恢复原因" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
            <TextBlock Classes="muted" Text="恢复会用这份备份替换目标赛事。替换前会保留原文件副本；更换文件或比赛后，需要重新检查和确认。" />
          </StackPanel>
        </Border>
        <Border Classes="callout" IsVisible="{Binding HasOutput}">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="上次操作的实际结果" />
            <SelectableTextBlock x:Name="RecoveryOutputDetails" Text="{Binding OutputDetails}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Expander Header="版本兼容与恢复说明">
          <TextBlock Classes="muted" Margin="0,12,0,0" Text="4.x 赛事文件仍需使用 v4.6.0。关闭面板后需要重新检查和确认；程序不会自动重试恢复。只有验证通过的备份才能作为恢复来源。" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Classes="action-bar">
      <StackPanel Spacing="10">
        <CheckBox x:Name="RecoveryConfirmation" IsChecked="{Binding Confirmed}" IsEnabled="{Binding HasPreview}">
          <TextBlock Text="我已核对目标完整路径、备份的赛事身份和保存进度，确认使用此备份替换目标。" TextWrapping="Wrap" />
        </CheckBox>
        <Button x:Name="RestoreBackupButton" Classes="danger" Content="确认恢复并保存" Command="{Binding RestoreCommand}" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
