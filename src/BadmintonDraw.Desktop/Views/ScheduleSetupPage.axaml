<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BadmintonDraw.Desktop.Controls"
             xmlns:vm="using:BadmintonDraw.Desktop.ViewModels" x:Class="BadmintonDraw.Desktop.Views.ScheduleSetupPage" x:DataType="vm:ScheduleSetupPageViewModel" Classes.read-only="{Binding !CanEdit}">
  <UserControl.Styles>
    <Style Selector="CalendarDatePicker">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="CalendarDatePicker:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="AutomationProperties.Name" Value="打开日历" />
      <Setter Property="Template">
        <ControlTemplate>
          <Path Width="20" Height="20" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                Data="M 4,5 L 20,5 L 20,21 L 4,21 Z M 4,10 L 20,10 M 8,2 L 8,7 M 16,2 L 16,7 M 8,14 L 11,14 M 14,14 L 17,14 M 8,18 L 11,18" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TimePicker">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <!-- Keep the native picker/popup; only replace its closed button presentation. -->
    <Style Selector="TimePicker /template/ Button#PART_FlyoutButton">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="TimeFieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,20">
              <TextBlock Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock.Text>
                  <Binding Path="$parent[TimePicker].SelectedTime" StringFormat="hh\:mm" TargetNullValue="选择时间" />
                </TextBlock.Text>
              </TextBlock>
              <Path Grid.Column="1" Width="20" Height="20" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                    VerticalAlignment="Center" IsHitTestVisible="False"
                    Data="M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 M 12,6 L 12,12 L 16,14" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TimePicker /template/ Button#PART_FlyoutButton:pointerover:not(:disabled) /template/ Border#TimeFieldBorder">
      <Setter Property="Background" Value="{DynamicResource AppInputHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputHoverBorderBrush}" />
    </Style>
    <Style Selector="TimePicker /template/ Button#PART_FlyoutButton:focus:not(:disabled) /template/ Border#TimeFieldBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TimePicker:disabled">
      <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
    </Style>
    <Style Selector=".read-only TextBox, .read-only ComboBox, .read-only CalendarDatePicker, .read-only TimePicker, .read-only CheckBox, .read-only StackPanel.editable-settings Button">
      <Setter Property="IsEnabled" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="ScheduleContent">
      <StackPanel Margin="28,28,28,24" Spacing="22">
        <StackPanel Spacing="8">
          <TextBlock Classes="eyebrow" Text="第四步 · 安排比赛时间" />
          <TextBlock Classes="page-title" Text="让每场比赛，都有合适的时间" />
          <TextBlock Classes="page-subtitle" Text="填写日期、场地和预计时长，程序会检查安排条件，为全部比赛生成赛程。" />
        </StackPanel>
        <Border Classes="callout"><StackPanel Spacing="6">
          <TextBlock Text="{Binding ScheduleSummary}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CapacitySummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EditHint}" TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Classes="card" IsVisible="{Binding HasFailure}" Background="{DynamicResource AppErrorCardBackgroundBrush}">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding FailureSummary}" FontWeight="SemiBold" Foreground="{DynamicResource AppErrorTextBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding FailureAdvice}" TextWrapping="Wrap" />
            <Expander Header="未安排场次与原因详情" IsExpanded="False" HorizontalAlignment="Stretch"><SelectableTextBlock Text="{Binding FailureTechnicalDetails}" TextWrapping="Wrap" Margin="0,10,0,0" /></Expander>
          </StackPanel>
        </Border>
        <Border Classes="callout" IsVisible="{Binding HasSuccessSummary}"><SelectableTextBlock Text="{Binding SuccessSummary}" TextWrapping="Wrap" /></Border>
        <StackPanel Classes="editable-settings" Spacing="22">
          <Border x:Name="MultiProjectNotice" Classes="inset" IsVisible="{Binding IsMultiProject}">
            <StackPanel Spacing="6"><TextBlock Text="多个项目，一起安排" FontWeight="SemiBold" />
              <TextBlock Text="多个项目会共享时间、场地和参赛人员，程序将统一安排全部项目。" TextWrapping="Wrap" Classes="muted" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12"><TextBlock Classes="section-title" Text="比赛安排" />
              <TextBlock Text="{Binding SchedulingHint}" TextWrapping="Wrap" Classes="muted" />
              <CheckBox x:Name="FinalsOnLastDay" IsChecked="{Binding RequireChampionshipFinalsOnLastDay}" IsVisible="{Binding IsMultiProject}"
                        AutomationProperties.Name="将各项目决赛安排在最后一个比赛日">
                <TextBlock Text="将各项目决赛安排在最后一个比赛日" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Text="{Binding FinalDayHint}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding IsMultiProject}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="14">
            <Grid x:Name="ScheduleDaysHeader" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4"><TextBlock Classes="section-title" Text="比赛日期与场地" /><TextBlock Classes="muted" Text="选择场馆，再勾选已预约或确认可用的场地；也可以使用自定义场馆。" TextWrapping="Wrap" /></StackPanel>
              <Button Grid.Column="1" Content="＋ 添加比赛日" Command="{Binding AddDayCommand}" Classes="secondary" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScheduleDayEditorViewModel">
              <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="14">
                  <WrapPanel>
                <StackPanel Width="174" Spacing="6" Margin="0,0,16,8"><TextBlock Text="比赛日期" /><controls:CalendarDateSelector SelectedDate="{Binding SelectedDate, Mode=TwoWay}" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" PlaceholderText="选择日期" AutomationProperties.Name="比赛日期" ToolTip.Tip="点击选择比赛日期" /></StackPanel>
                    <StackPanel Width="140" Spacing="6" Margin="0,0,16,8"><TextBlock Text="每天开始" /><controls:ClockTimeSelector SelectedTime="{Binding StartTime, Mode=TwoWay}" ClockIdentifier="24HourClock" MinuteIncrement="1" AutomationProperties.Name="比赛日开始时间" ToolTip.Tip="点击选择开始时间（24 小时制）" /></StackPanel>
                    <StackPanel Width="140" Spacing="6" Margin="0,0,16,8"><TextBlock Text="每天结束" /><controls:ClockTimeSelector SelectedTime="{Binding EndTime, Mode=TwoWay}" ClockIdentifier="24HourClock" MinuteIncrement="1" AutomationProperties.Name="比赛日结束时间" ToolTip.Tip="点击选择结束时间（24 小时制）" /></StackPanel>
                    <Button Content="移除这一天" Command="{Binding RemoveCommand}" Classes="quiet" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </WrapPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding VenueSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CourtsSummary}" Classes="muted" TextWrapping="Wrap" ToolTip.Tip="{Binding CourtsText}" />
                    <WrapPanel>
                      <Button x:Name="ChooseVenueCourtsButton" Content="选择场馆与场地" Command="{Binding ChooseCourtsCommand}" Classes="secondary" Margin="0,0,8,0" AutomationProperties.Name="选择比赛日的场馆与场地" />
                      <Button Content="沿用上一个比赛日的场地和时间" Command="{Binding CopyPreviousCourtsCommand}" Classes="quiet" AutomationProperties.Name="沿用上一个比赛日的场地和时间" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <StackPanel Spacing="14">
            <StackPanel Spacing="4"><TextBlock Classes="section-title" Text="每场比赛预留多久？" /><TextBlock Classes="muted" Text="{Binding MatchDurationHint}" TextWrapping="Wrap" /></StackPanel>
            <ItemsControl ItemsSource="{Binding ProjectTimings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScheduleProjectTimingViewModel">
              <Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,180">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="基础单场时长 · 分钟" /><TextBox Text="{Binding MinutesText}" AutomationProperties.Name="项目基础单场时长" /></StackPanel>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <Expander x:Name="AdvancedScheduleSettings" Header="高级排程设置" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20" Margin="0,16,0,0">
              <TextBlock Classes="muted" Text="{Binding AdvancedSettingsHint}" TextWrapping="Wrap" />
              <Border Classes="card"><StackPanel Spacing="14">
                <TextBlock Classes="section-title" Text="{Binding ResourceSettingsTitle}" />
                <WrapPanel>
                  <StackPanel Width="200" Spacing="6" Margin="0,0,16,8"><TextBlock Text="裁判人数" /><TextBox Text="{Binding RefereeCountText}" PlaceholderText="留空时按场地数计算" AutomationProperties.Name="全局裁判人数" /></StackPanel>
                  <StackPanel Width="200" Spacing="6" Margin="0,0,16,8" IsVisible="{Binding IsIndividual}"><TextBlock Text="选手最少休息 · 分钟" /><TextBox Text="{Binding MinimumRestText}" AutomationProperties.Name="全局最小休息分钟" /></StackPanel>
                  <StackPanel Width="200" Spacing="6" Margin="0,0,16,8" IsVisible="{Binding IsIndividual}"><TextBlock Text="每位选手每天最多场次" /><TextBox Text="{Binding DailyMaximumText}" AutomationProperties.Name="全局每日场次上限" /></StackPanel>
                </WrapPanel>
                <TextBlock Classes="muted" Text="{Binding ResourceConstraintsHint}" TextWrapping="Wrap" />
              </StackPanel></Border>
              <TextBlock Classes="section-title" Text="每天的特殊安排" />
              <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScheduleDayEditorViewModel">
                <Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="14">
                  <TextBlock Text="{Binding DateText}" FontSize="18" FontWeight="SemiBold" />
                  <Expander Header="不可用场地时段" HorizontalAlignment="Stretch"><StackPanel Spacing="10" Margin="0,12,0,0">
                    <TextBlock Classes="muted" Text="填写不能使用的时间，再从当天已选场地中勾选；选择“当天全部场地”可设置全场暂停。" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Unavailable}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScheduleUnavailableEditorViewModel">
                      <StackPanel Spacing="8" Margin="0,0,0,12">
                        <WrapPanel>
                          <TextBox Text="{Binding StartText}" Width="110" Margin="0,0,8,0" AutomationProperties.Name="不可用时段开始" />
                          <TextBox Text="{Binding EndText}" Width="110" Margin="0,0,8,0" AutomationProperties.Name="不可用时段结束" />
                          <Button Content="选择不可用场地…" Command="{Binding ChooseCourtsCommand}" Classes="secondary" Margin="0,0,8,0" />
                          <Button Content="移除" Command="{Binding RemoveCommand}" Classes="quiet" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CourtsSummary}" Classes="muted" TextWrapping="Wrap" ToolTip.Tip="{Binding CourtsText}" />
                      </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="＋ 添加不可用时段" Command="{Binding AddUnavailableCommand}" Classes="secondary" />
                  </StackPanel></Expander>
                  <Expander Header="分时段裁判人数" HorizontalAlignment="Stretch"><StackPanel Spacing="10" Margin="0,12,0,0">
                    <TextBlock Classes="muted" Text="依次填写开始、结束时间和可用裁判人数。" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RefereeWindows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScheduleRefereeEditorViewModel">
                      <Grid ColumnDefinitions="110,110,*,Auto" Margin="0,0,0,8">
                        <TextBox Text="{Binding StartText}" Margin="0,0,8,0" AutomationProperties.Name="裁判时段开始" />
                        <TextBox Grid.Column="1" Text="{Binding EndText}" Margin="0,0,8,0" AutomationProperties.Name="裁判时段结束" />
                        <TextBox Grid.Column="2" Text="{Binding CountText}" Margin="0,0,8,0" AutomationProperties.Name="时段裁判人数" />
                        <Button Grid.Column="3" Content="移除" Command="{Binding RemoveCommand}" Classes="quiet" />
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="＋ 添加裁判时段" Command="{Binding AddRefereeWindowCommand}" Classes="secondary" />
                  </StackPanel></Expander>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Classes="section-title" Text="分段比赛时长" IsVisible="{Binding HasTimingSplitSettings}" />
              <TextBlock Classes="muted" Text="分界前使用上方的基础时长。例如基础 20 分钟、前 16 名起 30 分钟：32 进 16 用 20 分钟，16 进 8 及以后用 30 分钟；排位赛使用后段时长。" TextWrapping="Wrap" IsVisible="{Binding HasTimingSplitSettings}" />
              <ItemsControl ItemsSource="{Binding ProjectTimings}" IsVisible="{Binding HasTimingSplitSettings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ScheduleProjectTimingViewModel">
                <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding SupportsTimingSplit}"><StackPanel Spacing="14">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                  <CheckBox Content="进入前 N 名起使用不同的比赛时长" IsChecked="{Binding UseTimingSplit}" IsVisible="{Binding SupportsTimingSplit}" />
                  <WrapPanel IsVisible="{Binding UseTimingSplit}">
                    <StackPanel Width="220" Spacing="6" Margin="0,0,12,8"><TextBlock Text="从前 N 名开始（含该轮）" /><TextBox Text="{Binding BoundaryText}" AutomationProperties.Name="淘汰赛时长分界人数" /></StackPanel>
                    <StackPanel Width="220" Spacing="6" Margin="0,0,12,8"><TextBlock Text="此后每场时长 · 分钟" /><TextBox Text="{Binding AfterMinutesText}" AutomationProperties.Name="分界起单场时长" /></StackPanel>
                  </WrapPanel>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Expander>
          <TextBlock Classes="muted" Text="{Binding GenerationHint}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="action-bar"><Grid ColumnDefinitions="*,Auto">
      <WrapPanel><Button Content="放弃未保存的修改" Command="{Binding ResetCommand}" Classes="quiet" Margin="0,0,8,0" /><Button Content="查看赛程板" Command="{Binding BoardCommand}" Classes="secondary" Margin="0,0,8,0" /><Button Content="选手兼项" IsVisible="{Binding ShowPlayerEntries}" Command="{Binding PlayerEntriesCommand}" Classes="secondary" /></WrapPanel>
      <Button Grid.Column="1" Content="检查并生成赛程" Command="{Binding GenerateCommand}" Classes="primary" />
    </Grid></Border>
  </Grid>
</UserControl>
