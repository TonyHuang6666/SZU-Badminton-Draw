<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BadmintonDraw.Desktop.ViewModels" x:Class="BadmintonDraw.Desktop.Views.RostersPage" x:DataType="vm:RostersPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="18">
      <TextBlock Text="各项目名单" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleBrush}" />
      <TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" />
      <ItemsControl ItemsSource="{Binding Projects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectRosterViewModel">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,6">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="160,*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,12,0" />
                  <Button Grid.Column="2" Content="导入 / 替换" Command="{Binding ImportCommand}" />
                </Grid>
                <SelectableTextBlock Text="{Binding SourceFileName}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" />
                <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="当前项目" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProjectRosterViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="前往公开抽签" Command="{Binding NextCommand}" Margin="12,0,0,0" />
      </Grid>
      <ContentControl Content="{Binding SelectedProject}" HorizontalContentAlignment="Stretch">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ProjectRosterViewModel">
            <StackPanel Spacing="16">
              <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                  <WrapPanel>
                    <Button Content="导入 / 替换名单" Command="{Binding ImportCommand}" Margin="0,0,10,8" />
                    <Button Content="导出名单模板" Command="{Binding ExportTemplateCommand}" Margin="0,0,10,8" />
                    <Button Content="审核 / 编辑种子" Command="{Binding BeginSeedEditCommand}" Margin="0,0,10,8" />
                  </WrapPanel>
                  <CheckBox Content="允许下一次模板导出覆盖同名文件（不覆盖名单来源或存档）" IsChecked="{Binding OverwriteTemplate}" />
                  <TextBlock Text="来源文件" FontWeight="SemiBold" /><SelectableTextBlock Text="{Binding SourceFileName}" TextWrapping="Wrap" />
                  <TextBlock Text="原始文件 SHA-256（不代表编辑后的名单）" Foreground="{DynamicResource AppMutedTextBrush}" />
                  <SelectableTextBlock Text="{Binding SourceHash}" TextWrapping="Wrap" FontSize="12" />
                  <SelectableTextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{DynamicResource AppAccentBrush}" />
                  <SelectableTextBlock Text="{Binding ExportDetails}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding EditHint}" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" />
              <WrapPanel IsVisible="{Binding IsSeedEditing}">
                <Button Content="保存种子设置" Command="{Binding SaveSeedsCommand}" Margin="0,0,10,8" />
                <Button Content="载入最新种子设置" Command="{Binding ResetSeedsCommand}" Margin="0,0,10,8" />
                <Button Content="取消编辑" Command="{Binding CancelSeedEditCommand}" Margin="0,0,10,8" />
              </WrapPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel MinWidth="660" Spacing="6">
                  <Grid ColumnDefinitions="40,2*,2*,65,80" Margin="10,0">
                    <TextBlock Text="序" /><TextBlock Grid.Column="1" Text="参赛方 / 学号 / 单位" /><TextBlock Grid.Column="2" Text="搭档 / 备注" />
                    <TextBlock Grid.Column="3" Text="种子" /><TextBlock Grid.Column="4" Text="种子序号" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RosterSeedRowViewModel">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="10">
                          <Grid ColumnDefinitions="40,2*,2*,65,80">
                            <TextBlock Text="{Binding Order}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0"><SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" /><SelectableTextBlock Text="{Binding Identity}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" /></StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0"><SelectableTextBlock Text="{Binding Partner}" TextWrapping="Wrap" /><TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" /></StackPanel>
                            <CheckBox Grid.Column="3" IsChecked="{Binding IsSeed}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="种子标记" />
                            <TextBox Grid.Column="4" Text="{Binding SeedRankText}" IsEnabled="{Binding CanEdit}" PlaceholderText="可留空" AutomationProperties.Name="种子序号" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
