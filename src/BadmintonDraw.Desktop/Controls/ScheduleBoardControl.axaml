<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BadmintonDraw.Desktop.Controls.ScheduleBoardControl" x:Name="BoardControl">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid x:Name="BoardToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,4" SizeChanged="ToolbarSizeChanged">
      <ScrollViewer x:Name="DayTabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DayTabs" Orientation="Horizontal" Spacing="4" /></ScrollViewer>
      <StackPanel x:Name="DisplayOptions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="8,0,0,0">
        <ToggleButton x:Name="CompactToggle" Content="紧凑" Classes="board-disclosure" IsChecked="{Binding IsCompact, ElementName=BoardControl, Mode=TwoWay}"
                      ToolTip.Tip="切换紧凑 / 详细卡片" AutomationProperties.Name="使用紧凑赛程卡片" />
        <Button Content="−" Click="ZoomOut" Classes="quiet" AutomationProperties.Name="缩小赛程板" />
        <Button x:Name="ZoomLabel" Content="100%" Click="ResetZoom" Classes="quiet" AutomationProperties.Name="重置赛程板缩放" />
        <Button Content="+" Click="ZoomIn" Classes="quiet" AutomationProperties.Name="放大赛程板" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Height="34" Margin="0,0,0,4" RowDefinitions="18,16">
      <Border x:Name="LocationSummary" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="LocationInfo" FontSize="11" Foreground="{DynamicResource AppTitleBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Button x:Name="CancelLocation" Grid.Column="1" Content="取消定位" Click="CancelMatchLocation" Classes="quiet" FontSize="11" Height="18" MinHeight="18" Padding="5,0" AutomationProperties.Name="取消当前比赛定位" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="FeedbackScroll" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Feedback" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </ScrollViewer>
    </Grid>
    <Grid x:Name="BoardPanes" Grid.Row="2" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*" Grid.IsSharedSizeScope="True">
      <Border x:Name="TimeAxisCorner" Background="{DynamicResource AppSurfaceMutedBrush}" BorderBrush="{DynamicResource AppSoftBorderBrush}" BorderThickness="0,0,1,1" Padding="6">
        <TextBlock Text="时间" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleBrush}" VerticalAlignment="Center" />
      </Border>
      <ScrollViewer x:Name="CourtHeaderScroll" Grid.Column="1" HorizontalAlignment="Left" IsHitTestVisible="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="CourtHeaderGrid" />
      </ScrollViewer>
      <ScrollViewer x:Name="TimeAxisScroll" Grid.Row="1" VerticalAlignment="Top" IsHitTestVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <Grid x:Name="TimeAxisGrid" />
      </ScrollViewer>
      <ScrollViewer x:Name="BoardScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="BoardScrollChanged">
        <Grid x:Name="BoardGrid" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
